{
  "manifest_version": 3,
  "name": "StudyGuard",
  "version": "1.1",
  "description": "StudyGuard browser protection",

  "permissions": [
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "chrome_url_overrides": {
    "newtab": "home.html"
  }
}