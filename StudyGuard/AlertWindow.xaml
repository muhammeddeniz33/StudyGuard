<Window x:Class="StudyGuard.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyGuard Alert"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#111111">

    <Grid>

        <StackPanel
            Width="650"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="DERS MODU İHLALİ"
                Foreground="Red"
                FontSize="42"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>

            <TextBlock
                x:Name="MessageText"
                Text="Ders modunda bu siteye erişemezsin."
                Foreground="White"
                FontSize="26"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,25"/>

            <TextBlock
                x:Name="UrlText"
                Foreground="#999999"
                FontSize="17"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,40"/>

            <PasswordBox
                x:Name="PinBox"
                Width="250"
                Height="45"
                FontSize="22"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"/>

            <Button
                Content="KİLİDİ KALDIR"
                Width="250"
                Height="50"
                FontSize="18"
                Click="Unlock_Click"/>

            <TextBlock
                x:Name="ErrorText"
                Foreground="Red"
                FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"/>

        </StackPanel>

    </Grid>
</Window>